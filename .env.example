# Optional. When omitted, the Research Agent runs in the safe browser sandbox.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# Required before real third-party OAuth can complete.
# Use a long random string or a base64-encoded 32-byte key.
CONNECTION_ENCRYPTION_KEY=

# Configure only the providers you want to enable.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
